{
  "$defs": {
    "FileDefinition": {
      "additionalProperties": false,
      "properties": {
        "expected_bytes": {
          "exclusiveMinimum": 0,
          "title": "Expected Bytes",
          "type": "integer"
        },
        "expected_md5": {
          "title": "Expected Md5",
          "type": "string"
        },
        "file_accession": {
          "title": "File Accession",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "role": {
          "enum": [
            "R1",
            "R2"
          ],
          "title": "Role",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "role",
        "file_accession",
        "filename",
        "url",
        "expected_bytes",
        "expected_md5"
      ],
      "title": "FileDefinition",
      "type": "object"
    },
    "SampleDefinition": {
      "additionalProperties": false,
      "properties": {
        "biological_replicate": {
          "exclusiveMinimum": 0,
          "title": "Biological Replicate",
          "type": "integer"
        },
        "biosample_accession": {
          "title": "Biosample Accession",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileDefinition"
          },
          "title": "Files",
          "type": "array"
        },
        "library_accession": {
          "title": "Library Accession",
          "type": "string"
        },
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "biological_replicate",
        "biosample_accession",
        "library_accession",
        "files"
      ],
      "title": "SampleDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assay": {
      "enum": [
        "polyA plus RNA-seq",
        "RNA-seq",
        "long-read RNA-seq"
      ],
      "title": "Assay",
      "type": "string"
    },
    "biosample": {
      "title": "Biosample",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "experiment_accession": {
      "title": "Experiment Accession",
      "type": "string"
    },
    "library_selection": {
      "enum": [
        "Poly(A)+",
        "rRNA depletion",
        "direct RNA",
        "cDNA"
      ],
      "title": "Library Selection",
      "type": "string"
    },
    "organism": {
      "const": "Homo sapiens",
      "title": "Organism",
      "type": "string"
    },
    "profile_id": {
      "default": "human_illumina_polya_bulk_v1",
      "enum": [
        "human_illumina_polya_bulk_v1",
        "human_illumina_rrna_depletion_bulk_v1",
        "human_longread_rnaseq_v1"
      ],
      "title": "Profile Id",
      "type": "string"
    },
    "read_layout": {
      "enum": [
        "paired-end",
        "single-end",
        "long-read"
      ],
      "title": "Read Layout",
      "type": "string"
    },
    "read_length": {
      "exclusiveMinimum": 0,
      "title": "Read Length",
      "type": "integer"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/SampleDefinition"
      },
      "title": "Samples",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequencing_center": {
      "default": "UNKNOWN",
      "title": "Sequencing Center",
      "type": "string"
    },
    "sequencing_platform": {
      "title": "Sequencing Platform",
      "type": "string"
    },
    "source_database": {
      "enum": [
        "ENCODE",
        "GEO",
        "SRA",
        "ENA",
        "USER_UPLOAD"
      ],
      "title": "Source Database",
      "type": "string"
    },
    "strandedness": {
      "enum": [
        "reverse",
        "forward",
        "unstranded",
        "auto",
        "unknown"
      ],
      "title": "Strandedness",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "source_database",
    "experiment_accession",
    "organism",
    "biosample",
    "assay",
    "library_selection",
    "read_layout",
    "read_length",
    "strandedness",
    "sequencing_platform",
    "samples"
  ],
  "title": "DatasetDefinition",
  "type": "object"
}
